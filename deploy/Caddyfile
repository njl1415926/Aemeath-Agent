{
	http_port 8080
	https_port 8443
	servers {
		protocols h1 h2
	}
}

{$AEMEATH_DOMAIN} {
	route {
		request_body {
			max_size 128KiB
		}

		# As the first hop, Caddy's default reverse_proxy behavior ignores
		# untrusted inbound X-Forwarded-* values and regenerates them.
		reverse_proxy {$AEMEATH_API_UPSTREAM:api:8000}
	}
}

# This file contains names and non-secret values only. Copy it outside the repo,
# set the deployment domain and the two approved user IDs, then protect it as 0640.
# compose.yaml forces the single approved Caddy IP inside the API container.
AEMEATH_DOMAIN=
AEMEATH_ENV_FILE=/etc/aemeath/prod.env
AEMEATH_IMAGE=aemeath-agent:local
# D6 backup identity. These are not secrets; set exact rollback values before
# running the ops profile. Missing values make backup_sqlite.py fail closed.
AEMEATH_APP_IMAGE_DIGEST=
AEMEATH_OPS_IMAGE_DIGEST=
AEMEATH_DEPLOY_LOCK_SHA256=
AEMEATH_COMPOSE_CONFIG_SHA256=
AEMEATH_BUILD_COMMIT=
AEMEATH_ENVIRONMENT=prod
AEMEATH_USE_MOCK_LLM=false
AEMEATH_DB_BACKEND=sqlite_raw
AEMEATH_DB_PATH=/var/lib/aemeath/data/aemeath.db
AEMEATH_MEMORY_VECTOR_DB_PATH=/var/lib/aemeath/data/aemeath_memory.sqlite
AEMEATH_CHARACTER_CARD_PATH=app/character/Aemeath.v0.2
AEMEATH_DIALOGUE_PROMPT_PATH=app/prompts/dialogue_prompt.v0.1.md
AEMEATH_DEFAULT_CHARACTER_ID=aemeath
AEMEATH_DEFAULT_USER_ID=
AEMEATH_DEV_AUTH_USER_ID=
AEMEATH_API_ALLOW_LOCAL_DEFAULT_USER=false

AEMEATH_ENABLE_MODEL_FALLBACK=false
AEMEATH_API_ENABLE_MODEL_FALLBACK=false
AEMEATH_ENABLE_LONG_TERM_MEMORY=false
AEMEATH_EMBEDDING_ALLOW_HASH=false
AEMEATH_ENABLE_CONTEXT_BUDGET=true

AEMEATH_ENABLE_PROMPT_RUN_LOG=false
AEMEATH_API_ENABLE_PROMPT_RUN_LOG=false
AEMEATH_ENABLE_APP_LOG=true
AEMEATH_ENABLE_TRACE_LOG=true
AEMEATH_APP_LOG_ROOT=/var/log/aemeath/app
AEMEATH_TRACE_LOG_ROOT=/var/log/aemeath/trace
AEMEATH_PROMPT_RUN_LOG_ROOT=/var/log/aemeath/prompt
AEMEATH_DEPLOYMENT_APP_ROOT=/opt/aemeath

AEMEATH_API_CORS_ALLOWED_ORIGINS=[]
AEMEATH_READINESS_TIMEOUT_SECONDS=0.5
AEMEATH_READINESS_DB_TIMEOUT_SECONDS=0.2
AEMEATH_READINESS_FILESYSTEM_CACHE_TTL_SECONDS=5
AEMEATH_READINESS_MIN_FREE_BYTES=67108864

DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY_FILE=/run/secrets/deepseek_api_key
AEMEATH_DEV_AUTH_TOKEN_FILE=/run/secrets/api_bearer_token
AEMEATH_TRUSTED_PROXY_IPS=

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_THINKING=disabled
DEEPSEEK_REASONING_EFFORT=
AEMEATH_DB_PATH=data/aemeath.db
AEMEATH_DB_BACKEND=sqlite_raw
AEMEATH_RECENT_MESSAGE_LIMIT=12
AEMEATH_ENABLE_LONG_TERM_MEMORY=false
AEMEATH_ENABLE_PROMPT_RUN_LOG=true
AEMEATH_PROMPT_RUN_LOG_ROOT=.aemeath/sessions
AEMEATH_ENABLE_TRACE_LOG=false
AEMEATH_TRACE_LOG_ROOT=.aemeath/traces
AEMEATH_ENABLE_APP_LOG=false
AEMEATH_APP_LOG_ROOT=.aemeath/app_logs
AEMEATH_ENABLE_MODEL_FALLBACK=true
AEMEATH_API_ENABLE_MODEL_FALLBACK=false
AEMEATH_USE_MOCK_LLM=true
AEMEATH_CHARACTER_CARD_PATH=app/character/Aemeath.v0.2
AEMEATH_DIALOGUE_PROMPT_PATH=app/prompts/dialogue_prompt.v0.1.md
AEMEATH_MEMORY_EMBEDDING_PROVIDER=hash
AEMEATH_MEMORY_EMBEDDING_MODEL_PATH=.cache/huggingface/BAAI/bge-m3
AEMEATH_MEMORY_VECTOR_DB_PATH=data/aemeath_memory.sqlite
AEMEATH_MEMORY_RECALL_TOP_K=4
AEMEATH_MEMORY_RECALL_THRESHOLD=0.45
AEMEATH_MEMORY_WORKER_POLL_INTERVAL_SECONDS=2
AEMEATH_MEMORY_WINDOW_SIZE=12
AEMEATH_ENABLE_MEMORY_WINDOW_EXTRACTION=true
AEMEATH_DEFAULT_USER_ID=user_default
AEMEATH_DEFAULT_CHARACTER_ID=aemeath
AEMEATH_DEV_AUTH_TOKEN=
AEMEATH_DEV_AUTH_USER_ID=user_default
AEMEATH_API_ALLOW_LOCAL_DEFAULT_USER=false
AEMEATH_API_ENABLE_PROMPT_RUN_LOG=false

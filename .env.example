AEMEATH_ENVIRONMENT=dev

# Development may use DEEPSEEK_API_KEY. Production must instead set only
# DEEPSEEK_API_KEY_FILE=/run/secrets/deepseek_api_key.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_THINKING=disabled
DEEPSEEK_REASONING_EFFORT=
DEEPSEEK_CONNECT_TIMEOUT_SECONDS=3
DEEPSEEK_READ_TIMEOUT_SECONDS=15
DEEPSEEK_WRITE_TIMEOUT_SECONDS=5
DEEPSEEK_POOL_TIMEOUT_SECONDS=1
DEEPSEEK_MAX_RETRIES=1
DEEPSEEK_RETRY_BACKOFF_SECONDS=0.25
DEEPSEEK_RETRY_BACKOFF_MAX_SECONDS=2
DEEPSEEK_RETRY_AFTER_MAX_SECONDS=5
DEEPSEEK_MAX_OUTPUT_TOKENS=1024
AEMEATH_DB_PATH=data/aemeath.db
AEMEATH_DB_BACKEND=sqlite_raw
AEMEATH_RECENT_MESSAGE_LIMIT=12
AEMEATH_ENABLE_LONG_TERM_MEMORY=false
AEMEATH_ENABLE_PROMPT_RUN_LOG=true
AEMEATH_PROMPT_RUN_LOG_ROOT=.aemeath/sessions
AEMEATH_ENABLE_TRACE_LOG=false
AEMEATH_TRACE_LOG_ROOT=.aemeath/traces
AEMEATH_ENABLE_APP_LOG=false
AEMEATH_APP_LOG_ROOT=.aemeath/app_logs
AEMEATH_ENABLE_MODEL_FALLBACK=true
AEMEATH_API_ENABLE_MODEL_FALLBACK=false
AEMEATH_RUNTIME_SESSION_WAIT_TIMEOUT_SECONDS=5
AEMEATH_RUNTIME_MAX_DIALOGUE_TURNS=2
AEMEATH_RUNTIME_DIALOGUE_WAIT_TIMEOUT_SECONDS=0.25
AEMEATH_RUNTIME_MAX_LLM_REQUESTS=2
AEMEATH_RUNTIME_LLM_WAIT_TIMEOUT_SECONDS=2
# v0.1 requires exactly one Embedding request slot; the inner provider is serial.
AEMEATH_RUNTIME_MAX_EMBEDDING_REQUESTS=1
AEMEATH_RUNTIME_EMBEDDING_WAIT_TIMEOUT_SECONDS=2
AEMEATH_CHAT_MESSAGE_MAX_CHARS=4000
AEMEATH_CHAT_MESSAGE_MAX_UTF8_BYTES=12000
AEMEATH_CHAT_METADATA_MAX_UTF8_BYTES=8192
AEMEATH_STREAM_RESPONSE_MAX_CHARS=32768
AEMEATH_STREAM_RESPONSE_MAX_UTF8_BYTES=98304
AEMEATH_STREAM_PUBLIC_DELTA_MAX_UTF8_BYTES=4096
AEMEATH_STREAM_PRODUCER_PUT_TIMEOUT_SECONDS=5
AEMEATH_STREAM_ORPHAN_RECOVERY_LIMIT=100
AEMEATH_SEMANTIC_SKIP_LOW_INFORMATION=true
AEMEATH_USE_MOCK_LLM=true
AEMEATH_CHARACTER_CARD_PATH=app/character/Aemeath.v0.2
AEMEATH_DIALOGUE_PROMPT_PATH=app/prompts/dialogue_prompt.v0.1.md
AEMEATH_ENABLE_CONTEXT_BUDGET=false
AEMEATH_CONTEXT_BUDGET_MAX_CHARS=24000
AEMEATH_CONTEXT_BUDGET_RECENT_MESSAGE_LIMIT=8
AEMEATH_CONTEXT_BUDGET_MEMORY_LIMIT=4
AEMEATH_CONTEXT_BUDGET_EVIDENCE_LIMIT=4

# Embedding Foundation canonical development configuration. deterministic_hash_v1
# is approved only for offline smoke and explicit development.
AEMEATH_EMBEDDING_PROFILE=deterministic_hash_v1
AEMEATH_EMBEDDING_ALLOW_HASH=true
AEMEATH_EMBEDDING_BATCH_SIZE=16
AEMEATH_EMBEDDING_TIMEOUT_SECONDS=30
AEMEATH_EMBEDDING_MAX_RETRIES=2
AEMEATH_EMBEDDING_RETRY_BACKOFF_SECONDS=0.25
AEMEATH_EMBEDDING_LOCAL_MODEL_PATH=.cache/huggingface/BAAI/bge-m3
AEMEATH_EMBEDDING_LOCAL_DEVICE=auto
AEMEATH_EMBEDDING_LOCAL_MAX_LENGTH=8192
AEMEATH_EMBEDDING_LAZY_LOAD=true

# Managed vector RAG generations remain standalone tooling until separately approved.
AEMEATH_RAG_INDEX_ROOT=data/rag_indexes

# Legacy Memory names remain available for one compatibility release.
# AEMEATH_MEMORY_EMBEDDING_PROVIDER=hash
# AEMEATH_MEMORY_EMBEDDING_MODEL_PATH=.cache/huggingface/BAAI/bge-m3

# SiliconFlow BGE-M3 is approved for normal API-backed Memory/Semantic runtime.
# Select it instead of deterministic_hash_v1, set ALLOW_HASH=false, and keep the
# real API key only in local .env or the process environment.
# AEMEATH_EMBEDDING_PROFILE=siliconflow_pro_bge_m3_v1
# AEMEATH_EMBEDDING_ALLOW_HASH=false
# SILICONFLOW_API_KEY=
AEMEATH_MEMORY_VECTOR_DB_PATH=data/aemeath_memory.sqlite
AEMEATH_MEMORY_RECALL_TOP_K=4
AEMEATH_MEMORY_RECALL_THRESHOLD=0.45
AEMEATH_MEMORY_WORKER_POLL_INTERVAL_SECONDS=2
AEMEATH_MEMORY_REPAIR_BATCH_SIZE=32
AEMEATH_MEMORY_REPAIR_INTERVAL_SECONDS=30
AEMEATH_MEMORY_REPAIR_MAX_BACKOFF_SECONDS=300
AEMEATH_MEMORY_WINDOW_SIZE=12
AEMEATH_ENABLE_MEMORY_WINDOW_EXTRACTION=true
AEMEATH_DEFAULT_USER_ID=user_default
AEMEATH_DEFAULT_CHARACTER_ID=aemeath
# Development may use AEMEATH_DEV_AUTH_TOKEN. Production must instead set only
# AEMEATH_DEV_AUTH_TOKEN_FILE=/run/secrets/api_bearer_token.
AEMEATH_DEV_AUTH_TOKEN=
AEMEATH_DEV_AUTH_USER_ID=user_default
AEMEATH_API_ALLOW_LOCAL_DEFAULT_USER=false
AEMEATH_API_AUTH_MODE=dev_bearer
# Web profile is enabled separately during frontend/E2E. In that profile set:
# AEMEATH_WEB_PUBLIC_ORIGIN=https://app.example.test
# AEMEATH_WEB_AUTH_CSRF_KEY_FILE=/run/secrets/web_auth_csrf_key
AEMEATH_INVITATION_TTL_SECONDS=86400
AEMEATH_PASSWORD_RESET_TTL_SECONDS=3600
AEMEATH_WEB_SESSION_IDLE_SECONDS=604800
AEMEATH_WEB_SESSION_ABSOLUTE_SECONDS=2592000
AEMEATH_WEB_SESSION_TOUCH_SECONDS=300
AEMEATH_WEB_AUTH_CLEANUP_BATCH_SIZE=100
AEMEATH_PASSWORD_PROFILE=argon2id_owasp_2026_v1
AEMEATH_PASSWORD_WORK_CONCURRENCY=1
AEMEATH_PASSWORD_WORK_WAIT_TIMEOUT_SECONDS=1
AEMEATH_AUTH_PRE_RATE_PER_MINUTE=20
AEMEATH_AUTH_PRE_BURST=5
AEMEATH_AUTH_PRE_GLOBAL_RATE_PER_MINUTE=300
AEMEATH_AUTH_PRE_GLOBAL_BURST=50
AEMEATH_AUTH_PRE_RATE_IDLE_TTL_SECONDS=600
AEMEATH_AUTH_PRE_RATE_MAX_BUCKETS=4096
AEMEATH_API_ENABLE_PROMPT_RUN_LOG=false
AEMEATH_API_CHAT_USER_RATE_PER_MINUTE=12
AEMEATH_API_CHAT_USER_BURST=4
AEMEATH_API_CHAT_IP_RATE_PER_MINUTE=60
AEMEATH_API_CHAT_IP_BURST=20
AEMEATH_API_RATE_LIMIT_IDLE_TTL_SECONDS=600
AEMEATH_API_CORS_ALLOWED_ORIGINS=[]
AEMEATH_READINESS_TIMEOUT_SECONDS=0.5
AEMEATH_READINESS_DB_TIMEOUT_SECONDS=0.2
AEMEATH_READINESS_FILESYSTEM_CACHE_TTL_SECONDS=5
AEMEATH_READINESS_MIN_FREE_BYTES=67108864

# Uvicorn trusts only these exact proxy IPs. Production requires one fixed Caddy IP.
# AEMEATH_TRUSTED_PROXY_IPS=127.0.0.1
